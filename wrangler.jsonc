{
  "name": "blake-woods",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"],
    "not_found_handling": "404-page"
  },
  "durable_objects": {"bindings": [{"name": "EXCHANGE", "class_name": "Exchange"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Exchange"]}],
  "observability": {"enabled": false}
}
