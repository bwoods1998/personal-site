{
  "name": "blake-woods",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "blakewoods.us", "custom_domain": true },
    { "pattern": "www.blakewoods.us", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"],
    "not_found_handling": "404-page"
  },
  "durable_objects": {"bindings": [{"name": "EXCHANGE", "class_name": "Exchange"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Exchange"]}],
  "observability": {"enabled": false}
}
