{
  "name": "blake-woods",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_email": [{ "name": "EMAIL", "destination_address": "blakewoods98@gmail.com", "allowed_sender_addresses": ["agent@blakewoods.us"] }],
  "triggers": { "crons": ["0 0 * * *"] },
  "routes": [
    { "pattern": "blakewoods.us", "custom_domain": true },
    { "pattern": "www.blakewoods.us", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"],
    "not_found_handling": "404-page"
  },
  "durable_objects": {"bindings": [{"name": "EXCHANGE", "class_name": "Exchange"}, {"name": "PORTFOLIO_STATE", "class_name": "PortfolioState"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Exchange"]}, {"tag": "v2", "new_sqlite_classes": ["PortfolioState"]}],
  "observability": {"enabled": false}
}
